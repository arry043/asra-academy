# =============================================================================
# ASRA Academy — environment variables
# Copy to `.env` (git-ignored) and adjust:   cp .env.example .env
#
# Scope legend
#   [LOCAL]  local development on your machine (Docker PostgreSQL + Redis)
#   [DEV]    shared development/staging deployment (Neon branch, hosted services)
#   [PROD]   production deployment (Neon main branch, production providers)
#
# NEVER commit real secrets. Hosted environments set these in the platform's
# secret manager, not in files.
# =============================================================================

# --- Runtime -----------------------------------------------------------------
# [LOCAL][DEV][PROD]  development | test | production
NODE_ENV=development
# [LOCAL][DEV][PROD]  API port
PORT=4000
# [LOCAL][DEV][PROD]  fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# --- Local Docker PostgreSQL (docker-compose.yml) ----------------------------
# [LOCAL] only. Used by Docker Compose to initialise the local database.
POSTGRES_DB=asra_academy
POSTGRES_USER=asra
POSTGRES_PASSWORD=change_me_local_only
POSTGRES_PORT=5432

# --- Database (Prisma) -------------------------------------------------------
# [LOCAL] Docker PostgreSQL — keep user/password/port/db in sync with the values above.
# [DEV][PROD] Neon POOLED connection string, e.g.
#   postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DB?sslmode=require
DATABASE_URL=postgresql://asra:change_me_local_only@localhost:5432/asra_academy?schema=public
# [LOCAL] same as DATABASE_URL.
# [DEV][PROD] Neon DIRECT (non-pooled) connection string — used for migrations.
DIRECT_DATABASE_URL=postgresql://asra:change_me_local_only@localhost:5432/asra_academy?schema=public
# [LOCAL][DEV][PROD] optional — max connections in the API's pg pool per process (default 10).
DATABASE_POOL_MAX=
# [LOCAL] optional — database used by `npm test -w @asra/api`. Defaults to DATABASE_URL with
# "_test" appended to the database name. Must be a local host and end with "_test".
TEST_DATABASE_URL=

# --- Redis -------------------------------------------------------------------
# [LOCAL] Docker Redis.  [DEV][PROD] hosted Redis URL (use rediss:// for TLS).
REDIS_URL=redis://localhost:6379
# [LOCAL] host port for the Docker Redis container.
REDIS_PORT=6379

# --- Authentication (Phase 03 — docs/AUTHENTICATION.md) ------------------------
# [LOCAL][DEV][PROD]  REQUIRED everywhere: >= 32 random characters. Use a different value per
# environment; never reuse the example. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# [LOCAL][DEV][PROD]  optional — defaults shown
JWT_ISSUER=asra-academy-api
JWT_AUDIENCE=asra-academy-web
JWT_ACCESS_TTL_MINUTES=15
REFRESH_SESSION_TTL_DAYS=30
PASSWORD_RESET_TTL_MINUTES=30
EMAIL_VERIFICATION_TTL_HOURS=24
# Refresh-token cookie. SECURE defaults to false for development/test and true otherwise
# (must be true in production). SAME_SITE: strict | lax | none (none requires SECURE=true).
# DOMAIN: leave empty (host-only) unless web and API need a shared parent domain.
AUTH_COOKIE_SECURE=
AUTH_COOKIE_SAME_SITE=strict
AUTH_COOKIE_DOMAIN=
# Auth rate-limit counters: redis (shared; falls back to memory if Redis is down) | memory
RATE_LIMIT_STORE=redis

# --- Web / CORS --------------------------------------------------------------
# [LOCAL][DEV][PROD]  public URL of the Next.js app (browser-exposed)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# [LOCAL][DEV][PROD]  public base URL of the API including version prefix (browser-exposed)
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
# [DEV][PROD] optional comma-separated CORS allow-list; defaults to NEXT_PUBLIC_APP_URL
CORS_ORIGINS=
# [DEV][PROD] optional — set to "true" to serve the internal design-system showcase (/design-system)
# from a production build, e.g. on staging for client review. Always on in development; 404 otherwise.
ENABLE_DESIGN_SYSTEM=
# [PROD only] set to "true" in the PRODUCTION build environment to let search engines index the
# public website (robots.txt + meta robots). Read at BUILD time. Leave empty for local, preview and
# staging. Enable only once the domain is live (W-04) and the legal pages carry approved text (U-01).
SITE_INDEXING_ENABLED=

# --- Object storage (provider pending — CLIENT-CLARIFICATIONS §R) -------------
# [DEV][PROD] (optional for LOCAL until the storage phase)
STORAGE_URL=
STORAGE_KEY=
STORAGE_SECRET=

# --- Payment gateway (provider pending — CLIENT-CLARIFICATIONS §M) -------------
# [DEV] sandbox/test keys   [PROD] live keys
PAYMENT_KEY=
PAYMENT_SECRET=

# --- Email (provider: Resend — CLIENT-CLARIFICATIONS §Q) -----------------------
# [LOCAL] console = print verification/reset links to the API log (development only; refused in
# production). Tests use memory automatically.
# [PROD] resend = deliver via Resend. Requires EMAIL_API_KEY and an EMAIL_FROM on a domain
# verified in Resend (not localhost). Production refuses to start with any other transport.
EMAIL_TRANSPORT=console
EMAIL_FROM=ASRA Academy <no-reply@localhost>
# [PROD] Resend API key (sending access is enough). Required only when EMAIL_TRANSPORT=resend.
EMAIL_API_KEY=

# --- WhatsApp (integration type pending — CLIENT-CLARIFICATIONS §P) ------------
# [LOCAL][DEV][PROD] official enquiry number for the click-to-chat button, with country code
# (e.g. 91XXXXXXXXXX; spaces/+/- are stripped). Browser-exposed, inlined at build time. Leave EMPTY
# until the client confirms the number (P-02) — no WhatsApp button renders while it is empty.
NEXT_PUBLIC_WHATSAPP_NUMBER=
# [DEV][PROD] only needed if WhatsApp Business API is chosen
WHATSAPP_API_KEY=
