// ASRA Academy — Prisma schema (PHASE 02 — Database & Backend Core; PHASE 06 course fields)
//
// Conventions (see docs/DATABASE.md):
// - Models are PascalCase singular; tables are snake_case plural via @@map.
// - Fields are camelCase; columns are snake_case via @map.
// - Primary keys are PostgreSQL-generated UUIDs: gen_random_uuid() (built in since PG 13; Neon + Docker).
//   Pure join tables use composite primary keys instead.
// - Timestamps are `timestamptz(3)` and are always written in UTC.
// - Catalogue data (levels, classes, streams, subjects, categories) is retired with `isActive = false`
//   rather than deleted; foreign keys to catalogue rows use RESTRICT so in-use rows cannot vanish.
// - Curriculum content (module → chapter → lesson → resource) is owned by its parent and CASCADEs.
// - CHECK constraints that Prisma cannot express live in the migration SQL and are listed in
//   docs/DATABASE.md §Constraints.
//
// Connection URLs are supplied via prisma.config.ts (CLI/migrations) and the
// @prisma/adapter-pg driver adapter (runtime). Production database: Neon PostgreSQL.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// =============================================================================
// Enums
// =============================================================================

/// Lifecycle of an account. Login rules per status are defined in PHASE 03.
enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED

  @@map("user_status")
}

/// Publication lifecycle shared by courses and lessons.
enum PublicationStatus {
  DRAFT
  PUBLISHED
  ARCHIVED

  @@map("publication_status")
}

/// Who can see a PUBLISHED course on the public website (docs/COURSE-MANAGEMENT.md §3).
/// Independent of `status`: a course that is not PUBLISHED is never public, whatever this says.
enum CourseVisibility {
  /// Listed in the public catalogue and reachable by its slug.
  PUBLIC
  /// Not listed; reachable only by its slug (shareable link), and `noindex`.
  UNLISTED
  /// Never exposed by public endpoints (reserved for enrolled-only access, PHASE 10).
  PRIVATE

  @@map("course_visibility")
}

/// How `Course.discountValue` is interpreted (CLIENT-CLARIFICATIONS M-06 pending).
enum DiscountType {
  /// Whole percent, 1–100.
  PERCENTAGE
  /// Amount in the course currency's minor unit, 1–price.
  FIXED_AMOUNT

  @@map("discount_type")
}

/// Primary kind of content a lesson delivers.
/// LINK = "External resource". QUIZ and ASSIGNMENT are placeholders (instructions + optional
/// resources) until the assessment engine exists (PHASE 09).
enum LessonContentType {
  VIDEO
  DOCUMENT
  TEXT
  LINK
  PDF
  QUIZ
  ASSIGNMENT

  @@map("lesson_content_type")
}

/// Kind of learning material attached to a lesson.
enum ResourceType {
  VIDEO
  PDF
  DOCUMENT
  PRESENTATION
  IMAGE
  AUDIO
  EXTERNAL_LINK
  OTHER

  @@map("resource_type")
}

// =============================================================================
// Identity & access control
// =============================================================================

/// Central identity. Authentication data lives here; role-specific data lives in profiles.
model User {
  id              String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Stored trimmed + lower-case (enforced by CHECK `users_email_normalized`).
  email           String     @unique @db.VarChar(320)
  /// bcrypt hash (PHASE 03). Nullable for admin-created accounts that have not set a password yet.
  passwordHash    String?    @map("password_hash") @db.VarChar(255)
  fullName        String     @map("full_name") @db.VarChar(150)
  /// Optional contact number; whether it is required/unique is pending (CLIENT-CLARIFICATIONS D-01/D-02).
  phone           String?    @db.VarChar(20)
  status          UserStatus @default(ACTIVE)
  emailVerifiedAt DateTime?  @map("email_verified_at") @db.Timestamptz(3)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  roles             UserRole[]
  studentProfile    StudentProfile?
  facultyProfile    FacultyProfile?
  sessions          AuthSession[]
  oneTimeTokens     OneTimeToken[]
  enrollments       Enrollment[]     @relation("EnrollmentStudent")
  enrollmentsByUser Enrollment[]     @relation("EnrollmentEnrolledBy")
  lessonProgress    LessonProgress[]

  assignmentsCreated   Assignment[]           @relation("AssignmentCreatedBy")
  submissions          AssignmentSubmission[] @relation("SubmissionStudent")
  submissionsGraded    AssignmentSubmission[] @relation("SubmissionGradedBy")
  liveClassesScheduled LiveClassSession[]     @relation("LiveClassCreatedBy")

  quizzesCreated      Quiz[]               @relation("QuizCreatedBy")
  examinationsCreated Examination[]        @relation("ExaminationCreatedBy")
  assessmentAttempts  AssessmentAttempt[]  @relation("AttemptStudent")
  answersGraded       AttemptQuestion[]    @relation("AttemptQuestionGradedBy")
  assessmentAuditLogs AssessmentAuditLog[] @relation("AuditActor")

  orders           Order[]           @relation("OrderStudent")
  payments         Payment[]         @relation("PaymentStudent")
  refundsRequested Refund[]          @relation("RefundRequestedBy")
  paymentAuditLogs PaymentAuditLog[] @relation("PaymentAuditActor")

  @@index([status])
  @@map("users")
}

/// A named set of permissions. System roles are seeded; more can be added as data.
model Role {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Stable machine identifier, e.g. `SUPER_ADMIN` (CHECK `roles_key_format`).
  key         String   @unique @db.VarChar(50)
  name        String   @db.VarChar(100)
  description String?  @db.VarChar(500)
  /// System roles are created by the seed and must not be deleted by administrators.
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

/// A single grantable capability, e.g. `courses.manage` (CHECK `permissions_key_format`).
model Permission {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key         String   @unique @db.VarChar(100)
  description String?  @db.VarChar(500)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  roles RolePermission[]

  @@map("permissions")
}

/// User ↔ Role (many-to-many). A role that is still assigned cannot be deleted.
model UserRole {
  userId     String   @map("user_id") @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

/// Role ↔ Permission (many-to-many).
model RolePermission {
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  grantedAt    DateTime @default(now()) @map("granted_at") @db.Timestamptz(3)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

// =============================================================================
// Authentication (PHASE 03) — see docs/AUTHENTICATION.md
// Only SHA-256 hashes of tokens are stored (CHECK `*_token_hash_format`); raw tokens exist
// only in the HttpOnly cookie / the emailed link.
// =============================================================================

/// Why a refresh session was revoked.
enum SessionRevocationReason {
  LOGOUT
  LOGOUT_ALL
  TOKEN_REUSE
  PASSWORD_RESET

  @@map("session_revocation_reason")
}

/// Purpose of a single-use emailed token.
enum OneTimeTokenPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET

  @@map("one_time_token_purpose")
}

/// A refresh session (one per login). The refresh token rotates on every use: `tokenHash` is the
/// current token, `previousTokenHash` the one it replaced — presenting the previous token again is
/// treated as theft and revokes the session. `expiresAt` is absolute (set at login, not extended).
model AuthSession {
  id                String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String                   @map("user_id") @db.Uuid
  tokenHash         String                   @unique @map("token_hash") @db.Char(64)
  previousTokenHash String?                  @unique @map("previous_token_hash") @db.Char(64)
  expiresAt         DateTime                 @map("expires_at") @db.Timestamptz(3)
  lastUsedAt        DateTime?                @map("last_used_at") @db.Timestamptz(3)
  revokedAt         DateTime?                @map("revoked_at") @db.Timestamptz(3)
  revokedReason     SessionRevocationReason? @map("revoked_reason")
  createdAt         DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("auth_sessions")
}

/// Single-use token for email verification or password reset. Consumed atomically
/// (`consumedAt`); issuing a new token of the same purpose deletes the user's unused ones.
model OneTimeToken {
  id         String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String              @map("user_id") @db.Uuid
  purpose    OneTimeTokenPurpose
  tokenHash  String              @unique @map("token_hash") @db.Char(64)
  expiresAt  DateTime            @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime?           @map("consumed_at") @db.Timestamptz(3)
  createdAt  DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId, purpose])
  @@index([expiresAt])
  @@map("one_time_tokens")
}

// =============================================================================
// Profiles
// =============================================================================

/// Student-specific academic data (1:1 with User). Guardian/DOB fields are pending
/// (CLIENT-CLARIFICATIONS D-01, E-01) and intentionally absent.
model StudentProfile {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String   @unique @map("user_id") @db.Uuid
  /// Academy-issued admission/student number; format pending.
  studentCode String?  @unique @map("student_code") @db.VarChar(50)
  /// Current class (nullable: special-course-only students have none).
  classId     String?  @map("class_id") @db.Uuid
  /// Current stream (Classes 11–12 only).
  streamId    String?  @map("stream_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  class  Class?  @relation(fields: [classId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  stream Stream? @relation(fields: [streamId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([classId])
  @@index([streamId])
  @@map("student_profiles")
}

/// Faculty-specific professional data (1:1 with User). Which fields are public is pending (C-02);
/// `isPublic` defaults to false so nothing is exposed until an admin opts in.
model FacultyProfile {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String   @unique @map("user_id") @db.Uuid
  /// Academy-issued employee/faculty identifier.
  employeeCode    String?  @unique @map("employee_code") @db.VarChar(50)
  /// Short title shown on profile cards, e.g. "Senior Mathematics Faculty".
  designation     String?  @db.VarChar(150)
  bio             String?  @db.Text
  qualifications  String?  @db.VarChar(500)
  specialization  String?  @db.VarChar(255)
  experienceYears Int?     @map("experience_years") @db.SmallInt
  /// Provider-neutral storage key of the profile photo (storage provider pending, R-01).
  photoKey        String?  @map("photo_key") @db.VarChar(1024)
  isPublic        Boolean  @default(false) @map("is_public")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  courses     CourseInstructor[]
  liveClasses LiveClassSession[]

  @@index([isPublic])
  @@map("faculty_profiles")
}

// =============================================================================
// Academic structure (data-driven; no catalogue is hard-coded — FR-ACA-003)
// =============================================================================

/// A band of school education, e.g. "Classes 6–10" or "Classes 11–12".
model AcademicLevel {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @unique @db.VarChar(100)
  slug        String   @unique @db.VarChar(120)
  description String?  @db.Text
  /// Curriculum/board label, e.g. "CBSE". Free text until boards are confirmed (A-03).
  board       String?  @db.VarChar(50)
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  classes Class[]
  streams Stream[]

  @@index([isActive, sortOrder])
  @@map("academic_levels")
}

/// A school grade, e.g. "Class 10". Belongs to exactly one academic level.
model Class {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  academicLevelId String   @map("academic_level_id") @db.Uuid
  name            String   @db.VarChar(100)
  slug            String   @unique @db.VarChar(120)
  /// Numeric grade (6–12) for filtering; not unique so a second board can reuse grades (A-03).
  gradeNumber     Int?     @map("grade_number") @db.SmallInt
  sortOrder       Int      @default(0) @map("sort_order")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  academicLevel AcademicLevel    @relation(fields: [academicLevelId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  courses       Course[]
  students      StudentProfile[]

  @@unique([academicLevelId, name])
  @@index([gradeNumber])
  @@index([isActive, sortOrder])
  @@map("classes")
}

/// An academic stream within a level, e.g. Science / Commerce / Arts for Classes 11–12.
/// The stream list is pending (A-02); streams are optional on courses and students.
model Stream {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  academicLevelId String   @map("academic_level_id") @db.Uuid
  name            String   @db.VarChar(100)
  slug            String   @unique @db.VarChar(120)
  description     String?  @db.Text
  sortOrder       Int      @default(0) @map("sort_order")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  academicLevel AcademicLevel    @relation(fields: [academicLevelId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  courses       Course[]
  students      StudentProfile[]

  @@unique([academicLevelId, name])
  @@index([isActive, sortOrder])
  @@map("streams")
}

/// A reusable subject, e.g. "Mathematics". Not tied to a single class: the class/stream in which a
/// subject is taught is expressed by a Course (SRS §1.3: a course is "a subject for a class").
model Subject {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @unique @db.VarChar(100)
  slug        String   @unique @db.VarChar(120)
  /// Optional external/board subject code, e.g. CBSE "041".
  code        String?  @unique @db.VarChar(20)
  description String?  @db.Text
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  courses Course[]

  @@index([isActive])
  @@map("subjects")
}

// =============================================================================
// Course management
// =============================================================================

/// Admin-managed grouping of courses, e.g. "School Education", "Language Courses".
model CourseCategory {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @unique @db.VarChar(100)
  slug        String   @unique @db.VarChar(120)
  description String?  @db.Text
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  courses Course[]

  @@index([isActive, sortOrder])
  @@map("course_categories")
}

/// An enrollable unit of learning: a subject for a class (optionally a stream), or a special course.
/// Enrolment and batches are deliberately absent (PHASE 10; CLIENT-CLARIFICATIONS B, M). Price and
/// discount are stored for administration only; no checkout price is derived from them (PHASE 10).
model Course {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title           String            @db.VarChar(200)
  slug            String            @unique @db.VarChar(220)
  summary         String?           @db.VarChar(500)
  description     String?           @db.Text
  status          PublicationStatus @default(DRAFT)
  visibility      CourseVisibility  @default(PUBLIC)
  categoryId      String?           @map("category_id") @db.Uuid
  classId         String?           @map("class_id") @db.Uuid
  streamId        String?           @map("stream_id") @db.Uuid
  subjectId       String?           @map("subject_id") @db.Uuid
  /// Provider-neutral storage key of the cover image (storage provider pending, R-01).
  thumbnailKey    String?           @map("thumbnail_key") @db.VarChar(1024)
  /// HTTPS URL of an externally hosted cover image. At most one of key/URL (CHECK).
  thumbnailUrl    String?           @map("thumbnail_url") @db.VarChar(2048)
  /// Estimated total learning time in MINUTES (CHECK > 0). Not a validity period (B-02).
  durationMinutes Int?              @map("duration_minutes")
  /// Price in the currency's minor unit (paise for INR); 0 = free. Set together with `currency`.
  priceMinor      Int?              @map("price_minor")
  /// ISO 4217 code, e.g. "INR" (M-03 pending: INR only is the current assumption).
  currency        String?           @db.Char(3)
  discountType    DiscountType?     @map("discount_type")
  discountValue   Int?              @map("discount_value")
  publishedAt     DateTime?         @map("published_at") @db.Timestamptz(3)
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  category     CourseCategory?    @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  class        Class?             @relation(fields: [classId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  stream       Stream?            @relation(fields: [streamId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  subject      Subject?           @relation(fields: [subjectId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  instructors  CourseInstructor[]
  modules      Module[]
  enrollments  Enrollment[]
  liveClasses  LiveClassSession[]
  examinations Examination[]
  orders       Order[]

  @@index([status, publishedAt])
  @@index([status, visibility])
  @@index([categoryId])
  @@index([classId, subjectId])
  @@index([streamId])
  @@index([subjectId])
  @@map("courses")
}

/// Course ↔ FacultyProfile assignment. Linking to FacultyProfile (not User) guarantees that only
/// faculty can be instructors. A faculty member with assignments cannot be deleted (RESTRICT).
model CourseInstructor {
  courseId         String   @map("course_id") @db.Uuid
  facultyProfileId String   @map("faculty_profile_id") @db.Uuid
  /// At most one primary instructor per course — enforced in the service layer (PHASE 06).
  isPrimary        Boolean  @default(false) @map("is_primary")
  assignedAt       DateTime @default(now()) @map("assigned_at") @db.Timestamptz(3)

  course         Course         @relation(fields: [courseId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  facultyProfile FacultyProfile @relation(fields: [facultyProfileId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@id([courseId, facultyProfileId])
  @@index([facultyProfileId])
  @@map("course_instructors")
}

// =============================================================================
// Curriculum & learning content: Course → Module → Chapter → Lesson → Resource
// `position` is a 0-based order unique within the parent (CHECK position >= 0).
// =============================================================================

model Module {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  courseId    String   @map("course_id") @db.Uuid
  title       String   @db.VarChar(200)
  description String?  @db.Text
  position    Int
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  course   Course    @relation(fields: [courseId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  chapters Chapter[]

  @@unique([courseId, position])
  @@map("modules")
}

model Chapter {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  moduleId    String   @map("module_id") @db.Uuid
  title       String   @db.VarChar(200)
  description String?  @db.Text
  position    Int
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  module  Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  lessons Lesson[]

  @@unique([moduleId, position])
  @@map("chapters")
}

model Lesson {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  chapterId       String            @map("chapter_id") @db.Uuid
  title           String            @db.VarChar(200)
  description     String?           @db.Text
  contentType     LessonContentType @map("content_type")
  /// Rich-text/markdown body for TEXT lessons or lesson notes.
  body            String?           @db.Text
  status          PublicationStatus @default(DRAFT)
  position        Int
  /// Expected duration (e.g. video length); CHECK >= 0.
  durationSeconds Int?              @map("duration_seconds")
  /// Visible to non-enrolled visitors (assumption H-04, pending client confirmation).
  isPreview       Boolean           @default(false) @map("is_preview")
  publishedAt     DateTime?         @map("published_at") @db.Timestamptz(3)
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  chapter          Chapter          @relation(fields: [chapterId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  resources        Resource[]
  progress         LessonProgress[]
  lastInEnrollment Enrollment[]
  /// Submission settings when `contentType` is ASSIGNMENT (PHASE 08).
  assignment       Assignment?
  /// Online quiz (questions, rules, attempts) when `contentType` is QUIZ (PHASE 09).
  quiz             Quiz?

  @@unique([chapterId, position])
  @@index([status])
  @@map("lessons")
}

/// Learning material attached to a lesson. Binary files are never stored in PostgreSQL: a resource
/// points EITHER to an object in storage (`storageProvider` + `storageKey`) OR to an `externalUrl`
/// (CHECK `resources_location_exclusive`). Storage provider is pending (R-01, G-01).
model Resource {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lessonId        String       @map("lesson_id") @db.Uuid
  title           String       @db.VarChar(200)
  type            ResourceType
  /// Adapter identifier, e.g. "s3", "r2", "vimeo" — set together with storageKey.
  storageProvider String?      @map("storage_provider") @db.VarChar(50)
  storageKey      String?      @map("storage_key") @db.VarChar(1024)
  externalUrl     String?      @map("external_url") @db.VarChar(2048)
  mimeType        String?      @map("mime_type") @db.VarChar(255)
  /// File size in bytes (CHECK >= 0).
  sizeBytes       BigInt?      @map("size_bytes")
  position        Int
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([lessonId, position])
  @@map("resources")
}

// =============================================================================
// Student learning (PHASE 07) — see docs/STUDENT-LMS.md
// Entitlement is an ACTIVE enrolment in a PUBLISHED course; progress is per student per lesson.
// Orders/payments (PHASE 10) will add a PAYMENT source; they never live in these tables.
// =============================================================================

/// Whether an enrolment currently grants access. Completion is recorded in `completedAt`, not as
/// a status, because new lessons can be added to a course after a student has finished it.
enum EnrollmentStatus {
  ACTIVE
  CANCELLED

  @@map("enrollment_status")
}

/// How the enrolment was created.
enum EnrollmentSource {
  /// Self-enrolment on a course whose price is explicitly 0.
  FREE
  /// Created by an administrator (e.g. offline payment or scholarship, M-07).
  ADMIN
  /// Activated by a verified, captured online payment (PHASE 10, docs/PAYMENTS.md). `orderId` set.
  PAYMENT

  @@map("enrollment_source")
}

/// A student's entitlement to one course. One row per (student, course): re-enrolling after a
/// cancellation reactivates the same row, so history and progress are never duplicated.
model Enrollment {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  courseId       String           @map("course_id") @db.Uuid
  status         EnrollmentStatus @default(ACTIVE)
  source         EnrollmentSource
  /// Administrator who created/reactivated an ADMIN enrolment (null for FREE).
  enrolledById   String?          @map("enrolled_by_id") @db.Uuid
  enrolledAt     DateTime         @default(now()) @map("enrolled_at") @db.Timestamptz(3)
  cancelledAt    DateTime?        @map("cancelled_at") @db.Timestamptz(3)
  /// First time every eligible lesson was completed (docs/STUDENT-LMS.md §4). Never cleared.
  completedAt    DateTime?        @map("completed_at") @db.Timestamptz(3)
  /// Resume point: the last lesson opened or progressed. SET NULL when that lesson is deleted.
  lastLessonId   String?          @map("last_lesson_id") @db.Uuid
  lastActivityAt DateTime?        @map("last_activity_at") @db.Timestamptz(3)
  /// The paid order that (re)activated a PAYMENT enrolment (PHASE 10). Kept when cancelled.
  orderId        String?          @map("order_id") @db.Uuid
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  user       User    @relation("EnrollmentStudent", fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  course     Course  @relation(fields: [courseId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  enrolledBy User?   @relation("EnrollmentEnrolledBy", fields: [enrolledById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  lastLesson Lesson? @relation(fields: [lastLessonId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  order      Order?  @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([userId, courseId])
  @@index([userId, status, lastActivityAt])
  @@index([courseId, status])
  @@index([lastLessonId])
  @@index([enrolledById])
  @@index([orderId])
  @@map("enrollments")
}

/// One student's progress in one lesson. Video fields are server-accumulated from throttled
/// heartbeats (docs/STUDENT-LMS.md §5); the client never sends a percentage or a completion flag.
model LessonProgress {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId               String    @map("user_id") @db.Uuid
  lessonId             String    @map("lesson_id") @db.Uuid
  firstViewedAt        DateTime  @default(now()) @map("first_viewed_at") @db.Timestamptz(3)
  lastViewedAt         DateTime  @default(now()) @map("last_viewed_at") @db.Timestamptz(3)
  /// Set by the explicit "Mark complete" action; cleared only by "Mark incomplete".
  completedAt          DateTime? @map("completed_at") @db.Timestamptz(3)
  /// Last playback position reported by the player, for resuming (CHECK >= 0).
  videoPositionSeconds Int?      @map("video_position_seconds")
  /// Seconds of playback credited by the server (bounded by wall-clock time between heartbeats).
  videoWatchedSeconds  Int       @default(0) @map("video_watched_seconds")
  /// Server time of the last accepted heartbeat; bounds the next credit.
  videoHeartbeatAt     DateTime? @map("video_heartbeat_at") @db.Timestamptz(3)
  /// Set when credited playback reaches the threshold of the lesson's configured duration.
  videoCompletedAt     DateTime? @map("video_completed_at") @db.Timestamptz(3)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([userId, lessonId])
  @@index([userId, lastViewedAt])
  @@index([lessonId])
  @@map("lesson_progress")
}

// =============================================================================
// Faculty portal (PHASE 08) — see docs/FACULTY-PORTAL.md
// Assignments reuse the curriculum: an ASSIGNMENT lesson holds the title, instructions (body),
// attachments (resources) and publication status; `Assignment` adds only the submission
// settings. Student work is never deleted by curriculum edits (RESTRICT + service guards).
// =============================================================================

/// Review state of a submission. Whether the student can SEE the grade is a separate decision
/// (`resultReleasedAt`), so saving a grade never publishes it by itself.
enum SubmissionStatus {
  /// Handed in, waiting for faculty review.
  SUBMITTED
  /// Marks (and optional feedback) recorded by faculty.
  GRADED

  @@map("submission_status")
}

/// Lifecycle of a scheduled live class. "Upcoming"/"past" are derived from the time; the
/// platform never claims a class is live (no provider reports it, F-01).
enum LiveClassStatus {
  SCHEDULED
  CANCELLED

  @@map("live_class_status")
}

/// Submission settings of one ASSIGNMENT lesson (1:1). Grading scale is numeric marks out of
/// `maxMarks` (I-03 assumption). Late-submission and resubmission rules are per assignment
/// (PHASE 09; I-02 pending — defaults keep the PHASE 08 behaviour).
model Assignment {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lessonId             String    @unique @map("lesson_id") @db.Uuid
  /// Whole marks, 1–1000 (CHECK).
  maxMarks             Int       @map("max_marks")
  /// Optional deadline (UTC), compared with SERVER time only.
  dueAt                DateTime? @map("due_at") @db.Timestamptz(3)
  /// After `dueAt`: true = accepted and flagged late; false = refused (409).
  allowLateSubmissions Boolean   @default(true) @map("allow_late_submissions")
  /// A student may replace their work until it is graded (previous versions are kept).
  allowResubmission    Boolean   @default(false) @map("allow_resubmission")
  createdById          String?   @map("created_by_id") @db.Uuid
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  lesson      Lesson                 @relation(fields: [lessonId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  createdBy   User?                  @relation("AssignmentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  submissions AssignmentSubmission[]

  @@index([createdById])
  @@map("assignments")
}

/// One student's work for one assignment (one row per student and assignment). The row holds the
/// CURRENT version; a permitted resubmission archives the previous version in
/// `assignment_submission_revisions` first, so submitted work is never silently overwritten.
model AssignmentSubmission {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assignmentId     String           @map("assignment_id") @db.Uuid
  userId           String           @map("user_id") @db.Uuid
  /// The student's answer as plain text (rendered as text, never HTML).
  body             String           @db.Text
  /// Optional https:// link to the student's work (no file storage yet, R-01). CHECK https.
  attachmentUrl    String?          @map("attachment_url") @db.VarChar(2048)
  /// Server time at which the current version was accepted.
  submittedAt      DateTime         @default(now()) @map("submitted_at") @db.Timestamptz(3)
  /// Decided by the server when the version was accepted (after the due date at that time).
  late             Boolean          @default(false)
  /// 1 for the first submission, +1 per accepted resubmission (CHECK >= 1).
  version          Int              @default(1)
  status           SubmissionStatus @default(SUBMITTED)
  /// 0–maxMarks, validated by the service; set together with `gradedAt` (CHECK).
  marksAwarded     Int?             @map("marks_awarded")
  feedback         String?          @db.Text
  /// Private note for faculty only — never returned to the student.
  facultyNote      String?          @map("faculty_note") @db.Text
  gradedById       String?          @map("graded_by_id") @db.Uuid
  gradedAt         DateTime?        @map("graded_at") @db.Timestamptz(3)
  /// When the grade became visible to the student. Only a GRADED submission can be released.
  resultReleasedAt DateTime?        @map("result_released_at") @db.Timestamptz(3)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  assignment Assignment                     @relation(fields: [assignmentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  student    User                           @relation("SubmissionStudent", fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  gradedBy   User?                          @relation("SubmissionGradedBy", fields: [gradedById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  revisions  AssignmentSubmissionRevision[]

  @@unique([assignmentId, userId])
  @@index([assignmentId, status])
  @@index([userId, resultReleasedAt])
  @@index([gradedById])
  @@map("assignment_submissions")
}

/// An earlier version of a submission, archived when the student resubmitted (PHASE 09).
/// Append-only: rows are never updated.
model AssignmentSubmissionRevision {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  submissionId  String   @map("submission_id") @db.Uuid
  version       Int
  body          String   @db.Text
  attachmentUrl String?  @map("attachment_url") @db.VarChar(2048)
  submittedAt   DateTime @map("submitted_at") @db.Timestamptz(3)
  late          Boolean
  archivedAt    DateTime @default(now()) @map("archived_at") @db.Timestamptz(3)

  submission AssignmentSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([submissionId, version])
  @@map("assignment_submission_revisions")
}

/// A live online class scheduled for a course. Provider-neutral: no meeting is created through
/// any provider API (F-01 pending). `joinUrl` is only ever a link entered by faculty
/// (`provider = 'manual'`) and is returned only to the course's faculty and enrolled students.
model LiveClassSession {
  id                   String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  courseId             String          @map("course_id") @db.Uuid
  /// Faculty member who hosts the class (the one who scheduled it).
  hostFacultyProfileId String?         @map("host_faculty_profile_id") @db.Uuid
  title                String          @db.VarChar(200)
  description          String?         @db.Text
  startsAt             DateTime        @map("starts_at") @db.Timestamptz(3)
  /// 15–480 minutes (CHECK).
  durationMinutes      Int             @map("duration_minutes")
  status               LiveClassStatus @default(SCHEDULED)
  /// Adapter id; "manual" = link typed by faculty. Null = no meeting link.
  provider             String?         @db.VarChar(50)
  joinUrl              String?         @map("join_url") @db.VarChar(2048)
  cancelledAt          DateTime?       @map("cancelled_at") @db.Timestamptz(3)
  createdById          String?         @map("created_by_id") @db.Uuid
  createdAt            DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  course    Course          @relation(fields: [courseId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  host      FacultyProfile? @relation(fields: [hostFacultyProfileId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  createdBy User?           @relation("LiveClassCreatedBy", fields: [createdById], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([courseId, startsAt])
  @@index([hostFacultyProfileId, startsAt])
  @@index([createdById])
  @@map("live_class_sessions")
}

// =============================================================================
// Assessment engine (PHASE 09) — see docs/ASSESSMENTS.md
// Quiz = online extension of a QUIZ lesson (like Assignment for ASSIGNMENT lessons).
// Examination = scheduled, timed assessment of a course.
// Both share the question bank and the attempt model. An attempt copies its questions, options,
// answer keys and marks into `attempt_questions.snapshot` when it starts, so later edits never
// change what a student answered or how it was scored. Marks are DECIMAL(…,2) (two decimals).
// =============================================================================

/// Lifecycle of a quiz or examination. DRAFT: editable, invisible to students. PUBLISHED: open
/// under its rules (questions frozen). CLOSED: no new attempts; history and results kept.
enum AssessmentStatus {
  DRAFT
  PUBLISHED
  CLOSED

  @@map("assessment_status")
}

enum QuestionType {
  /// MCQ with exactly one correct option.
  SINGLE_CHOICE
  /// Two options ("True", "False"), exactly one correct.
  TRUE_FALSE
  /// One or more correct options; scored all-or-nothing (docs/ASSESSMENTS.md §6).
  MULTIPLE_CHOICE
  /// Written answer graded manually by faculty. Examinations only.
  SHORT_ANSWER

  @@map("question_type")
}

/// When students may see correct answers and explanations (always after their result is visible).
enum AnswerReveal {
  NEVER
  AFTER_SUBMISSION
  /// After the quiz/exam is CLOSED (or, for exams, its window has ended).
  AFTER_CLOSE

  @@map("answer_reveal")
}

/// IN_PROGRESS → SUBMITTED (student submitted before the deadline) or EXPIRED (the server
/// finalized it at its deadline with the answers saved so far). Both final states are terminal.
enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  EXPIRED

  @@map("attempt_status")
}

/// Set when an attempt is finalized. PENDING = written answers still need manual grading.
enum EvaluationStatus {
  PENDING
  EVALUATED

  @@map("evaluation_status")
}

/// Online quiz of one QUIZ lesson (1:1). The lesson holds title, instructions and curriculum
/// publication; the quiz holds the rules. Students can attempt it only when the course, the lesson
/// AND the quiz are PUBLISHED.
model Quiz {
  id                    String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lessonId              String           @unique @map("lesson_id") @db.Uuid
  status                AssessmentStatus @default(DRAFT)
  /// Minutes per attempt (1–300, CHECK); null = untimed.
  timeLimitMinutes      Int?             @map("time_limit_minutes")
  /// 1–20 attempts per student (CHECK).
  maxAttempts           Int              @default(1) @map("max_attempts")
  /// Whole percent 0–100 (CHECK); passed ⇔ score ≥ passPercent % of the attempt's maximum.
  passPercent           Int              @default(40) @map("pass_percent")
  /// Applies each question's `negativeMarks` to wrong answers; ignored when false.
  negativeMarking       Boolean          @default(false) @map("negative_marking")
  shuffleQuestions      Boolean          @default(false) @map("shuffle_questions")
  shuffleOptions        Boolean          @default(false) @map("shuffle_options")
  /// Random subset size per attempt (CHECK >= 1); null = every question.
  questionsPerAttempt   Int?             @map("questions_per_attempt")
  /// true: score visible on submission; false: after faculty publish results.
  showResultImmediately Boolean          @default(true) @map("show_result_immediately")
  answerReveal          AnswerReveal     @default(AFTER_CLOSE) @map("answer_reveal")
  resultsPublishedAt    DateTime?        @map("results_published_at") @db.Timestamptz(3)
  publishedAt           DateTime?        @map("published_at") @db.Timestamptz(3)
  closedAt              DateTime?        @map("closed_at") @db.Timestamptz(3)
  createdById           String?          @map("created_by_id") @db.Uuid
  createdAt             DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  lesson    Lesson               @relation(fields: [lessonId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  createdBy User?                @relation("QuizCreatedBy", fields: [createdById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  questions AssessmentQuestion[]
  attempts  AssessmentAttempt[]

  @@index([status])
  @@index([createdById])
  @@map("quizzes")
}

/// A scheduled examination of a course. The server alone decides availability and deadlines:
/// an attempt may start in [opensAt, closesAt) and its deadline is
/// min(start + durationMinutes, closesAt).
model Examination {
  id                 String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  courseId           String           @map("course_id") @db.Uuid
  title              String           @db.VarChar(200)
  /// Plain text shown before the attempt starts.
  instructions       String?          @db.Text
  status             AssessmentStatus @default(DRAFT)
  opensAt            DateTime         @map("opens_at") @db.Timestamptz(3)
  /// CHECK closesAt > opensAt.
  closesAt           DateTime         @map("closes_at") @db.Timestamptz(3)
  /// 1–600 minutes per attempt (CHECK).
  durationMinutes    Int              @map("duration_minutes")
  /// 1–5 attempts (CHECK).
  maxAttempts        Int              @default(1) @map("max_attempts")
  passPercent        Int              @default(40) @map("pass_percent")
  negativeMarking    Boolean          @default(false) @map("negative_marking")
  shuffleQuestions   Boolean          @default(false) @map("shuffle_questions")
  shuffleOptions     Boolean          @default(false) @map("shuffle_options")
  /// Answers are only ever revealed after results are published.
  answerReveal       AnswerReveal     @default(NEVER) @map("answer_reveal")
  /// Results are released explicitly by faculty (K-04 assumption), never automatically.
  resultsPublishedAt DateTime?        @map("results_published_at") @db.Timestamptz(3)
  publishedAt        DateTime?        @map("published_at") @db.Timestamptz(3)
  closedAt           DateTime?        @map("closed_at") @db.Timestamptz(3)
  createdById        String?          @map("created_by_id") @db.Uuid
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  course    Course               @relation(fields: [courseId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdBy User?                @relation("ExaminationCreatedBy", fields: [createdById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  questions AssessmentQuestion[]
  attempts  AssessmentAttempt[]

  @@index([courseId, opensAt])
  @@index([status, closesAt])
  @@index([createdById])
  @@map("examinations")
}

/// A question of exactly one quiz OR one examination (CHECK). Editable only while its
/// assessment is DRAFT; attempts keep their own snapshot.
model AssessmentQuestion {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  quizId        String?      @map("quiz_id") @db.Uuid
  examinationId String?      @map("examination_id") @db.Uuid
  type          QuestionType
  /// Plain text (rendered as text, never HTML).
  prompt        String       @db.Text
  /// Shown with the correct answer when answers are revealed.
  explanation   String?      @db.Text
  /// Marks for a correct answer, 0.25–100 (CHECK).
  marks         Decimal      @db.Decimal(6, 2)
  /// Deducted for a wrong answer when negative marking is on; 0–marks (CHECK).
  negativeMarks Decimal      @default(0) @map("negative_marks") @db.Decimal(6, 2)
  /// 0-based display order within the assessment.
  position      Int
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  quiz        Quiz?                      @relation(fields: [quizId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  examination Examination?               @relation(fields: [examinationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  options     AssessmentQuestionOption[]
  attemptRefs AttemptQuestion[]

  @@index([quizId, position])
  @@index([examinationId, position])
  @@map("assessment_questions")
}

model AssessmentQuestionOption {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  questionId String  @map("question_id") @db.Uuid
  text       String  @db.VarChar(1000)
  isCorrect  Boolean @default(false) @map("is_correct")
  position   Int

  question AssessmentQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([questionId, position])
  @@map("assessment_question_options")
}

/// One student's attempt at a quiz OR an examination (CHECK). Times are server times. Attempt
/// numbers are unique per student and assessment, which also makes the attempt limit safe under
/// concurrent starts. Never deleted while the assessment exists (RESTRICT).
model AssessmentAttempt {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  quizId           String?           @map("quiz_id") @db.Uuid
  examinationId    String?           @map("examination_id") @db.Uuid
  userId           String            @map("user_id") @db.Uuid
  attemptNumber    Int               @map("attempt_number")
  status           AttemptStatus     @default(IN_PROGRESS)
  startedAt        DateTime          @map("started_at") @db.Timestamptz(3)
  /// Authoritative deadline computed by the server at start; null = untimed quiz.
  deadlineAt       DateTime?         @map("deadline_at") @db.Timestamptz(3)
  /// Server time the answers were frozen: the submit time, or `deadlineAt` for EXPIRED.
  submittedAt      DateTime?         @map("submitted_at") @db.Timestamptz(3)
  /// When the server processed the finalization (may be after `deadlineAt` for EXPIRED).
  finalizedAt      DateTime?         @map("finalized_at") @db.Timestamptz(3)
  evaluationStatus EvaluationStatus? @map("evaluation_status")
  maxScore         Decimal           @map("max_score") @db.Decimal(8, 2)
  /// Σ marks of correct/graded answers (before penalties).
  rawScore         Decimal?          @map("raw_score") @db.Decimal(8, 2)
  penalty          Decimal?          @db.Decimal(8, 2)
  /// max(0, rawScore − penalty).
  score            Decimal?          @db.Decimal(8, 2)
  /// score ÷ maxScore × 100, rounded half-up to 2 decimals.
  percent          Decimal?          @db.Decimal(5, 2)
  passed           Boolean?
  evaluatedAt      DateTime?         @map("evaluated_at") @db.Timestamptz(3)
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  quiz        Quiz?             @relation(fields: [quizId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  examination Examination?      @relation(fields: [examinationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  student     User              @relation("AttemptStudent", fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  questions   AttemptQuestion[]

  @@unique([quizId, userId, attemptNumber])
  @@unique([examinationId, userId, attemptNumber])
  @@index([status, deadlineAt])
  @@index([userId, status])
  @@index([examinationId, status])
  @@map("assessment_attempts")
}

/// One question assigned to one attempt, with its frozen snapshot and the student's answer.
/// `snapshot` = { prompt, explanation, options: [{ id, text, isCorrect }] } in display order;
/// it never leaves the server with `isCorrect` before answers may be revealed.
model AttemptQuestion {
  id                String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  attemptId         String       @map("attempt_id") @db.Uuid
  /// Source question (SET NULL if it is ever deleted; the snapshot stays authoritative).
  questionId        String?      @map("question_id") @db.Uuid
  position          Int
  type              QuestionType
  snapshot          Json
  marks             Decimal      @db.Decimal(6, 2)
  negativeMarks     Decimal      @map("negative_marks") @db.Decimal(6, 2)
  /// Options chosen by the student (ids from the snapshot).
  selectedOptionIds String[]     @default([]) @map("selected_option_ids") @db.Uuid
  textAnswer        String?      @map("text_answer") @db.Text
  /// Highest client sequence applied; older autosaves arriving late are ignored.
  answerSequence    Int          @default(0) @map("answer_sequence")
  answeredAt        DateTime?    @map("answered_at") @db.Timestamptz(3)
  /// Set at evaluation (objective) or manual grading (SHORT_ANSWER).
  awardedMarks      Decimal?     @map("awarded_marks") @db.Decimal(6, 2)
  penalty           Decimal?     @db.Decimal(6, 2)
  isCorrect         Boolean?     @map("is_correct")
  feedback          String?      @db.Text
  gradedById        String?      @map("graded_by_id") @db.Uuid
  gradedAt          DateTime?    @map("graded_at") @db.Timestamptz(3)

  attempt  AssessmentAttempt   @relation(fields: [attemptId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  question AssessmentQuestion? @relation(fields: [questionId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  gradedBy User?               @relation("AttemptQuestionGradedBy", fields: [gradedById], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@unique([attemptId, position])
  @@index([questionId])
  @@index([gradedById])
  @@map("attempt_questions")
}

/// Append-only record of consequential assessment actions (publication, finalization, grading,
/// grade revisions, result release). No FK on the subject so history survives deletions.
model AssessmentAuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// e.g. "quiz.published", "attempt.finalized", "submission.graded".
  action     String   @db.VarChar(60)
  /// null for system actions (e.g. the expiry sweeper).
  actorId    String?  @map("actor_id") @db.Uuid
  entityType String   @map("entity_type") @db.VarChar(40)
  entityId   String   @map("entity_id") @db.Uuid
  data       Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([entityType, entityId, createdAt])
  @@index([actorId])
  @@map("assessment_audit_logs")
}

// =============================================================================
// Enrolment & payment (PHASE 10) — see docs/PAYMENTS.md
// Order (what the student asked to buy, at a frozen price) → Payment (one provider transaction;
// an order may see several attempts) → Enrollment (the entitlement, activated only by a captured,
// verified payment) → Refund (separate rows; the payment itself is never rewritten).
// Money is integer MINOR units (paise for INR). Every row records the provider and the mode
// (TEST/LIVE) it was created in, and is only ever processed with that mode's credentials.
// Financial history is never deleted: foreign keys to orders/payments are RESTRICT.
// =============================================================================

/// Razorpay environment a row belongs to. Never changes after creation.
enum PaymentMode {
  TEST
  LIVE

  @@map("payment_mode")
}

enum PaymentProvider {
  RAZORPAY

  @@map("payment_provider")
}

/// CREATED: local row only (provider order not created yet, or that call failed — retried).
/// PENDING: provider order exists; the student may pay (several attempts allowed).
/// PAID: a captured payment matched the order. Terminal (refunds do not change it).
/// CANCELLED: superseded by a newer order (e.g. the price changed). EXPIRED: unpaid past `expiresAt`.
/// A captured payment that arrives for a CANCELLED/EXPIRED order is still honoured (the money was
/// taken), which moves the order to PAID.
enum OrderStatus {
  CREATED
  PENDING
  PAID
  CANCELLED
  EXPIRED

  @@map("order_status")
}

/// Mirrors Razorpay's payment lifecycle. Transitions are monotonic: CAPTURED is never downgraded,
/// and a late FAILED never overrides AUTHORIZED/CAPTURED (Razorpay may capture after a failure).
/// Refund state is tracked by `refundedMinor` and the Refund rows, not by this status.
enum PaymentStatus {
  CREATED
  AUTHORIZED
  CAPTURED
  FAILED

  @@map("payment_status")
}

/// REQUESTED: local row written before the provider call (crash-safe; `receipt` is the provider
/// idempotency key). PENDING/PROCESSED/FAILED mirror Razorpay. PROCESSED is terminal.
enum RefundStatus {
  REQUESTED
  PENDING
  PROCESSED
  FAILED

  @@map("refund_status")
}

/// Durable webhook processing state. An event is marked PROCESSED only after its changes commit;
/// a PROCESSING row older than the lease is reclaimed by the next delivery.
enum WebhookEventStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  IGNORED
  FAILED

  @@map("webhook_event_status")
}

/// A purchase request for one course at the price in force when it was created (snapshot).
/// At most one CREATED/PENDING order per student and course (partial unique index in SQL).
model Order {
  id                         String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Human-readable reference, e.g. "ASRA-261019-7KQ2M9XD"; sent to Razorpay as the receipt.
  reference                  String          @unique @db.VarChar(40)
  userId                     String          @map("user_id") @db.Uuid
  courseId                   String          @map("course_id") @db.Uuid
  status                     OrderStatus     @default(CREATED)
  provider                   PaymentProvider @default(RAZORPAY)
  mode                       PaymentMode
  /// Public key id the provider order was created with (audit: which account).
  providerKeyId              String          @map("provider_key_id") @db.VarChar(64)
  providerOrderId            String?         @unique @map("provider_order_id") @db.VarChar(64)
  currency                   String          @db.Char(3)
  /// Snapshot of the course at order time (CHECKs: amounts >= 0, amount = list − discount).
  courseTitle                String          @map("course_title") @db.VarChar(200)
  listPriceMinor             Int             @map("list_price_minor")
  discountType               DiscountType?   @map("discount_type")
  discountValue              Int?            @map("discount_value")
  discountMinor              Int             @default(0) @map("discount_minor")
  amountMinor                Int             @map("amount_minor")
  expiresAt                  DateTime        @map("expires_at") @db.Timestamptz(3)
  paidAt                     DateTime?       @map("paid_at") @db.Timestamptz(3)
  cancelledAt                DateTime?       @map("cancelled_at") @db.Timestamptz(3)
  /// Safe, student-visible reason of the last problem (provider unavailable, last attempt failed…).
  failureReason              String?         @map("failure_reason") @db.VarChar(500)
  lastReconciledAt           DateTime?       @map("last_reconciled_at") @db.Timestamptz(3)
  reconcileAttempts          Int             @default(0) @map("reconcile_attempts")
  /// Claimed by exactly one process before the confirmation email is sent (no duplicates).
  confirmationEmailClaimedAt DateTime?       @map("confirmation_email_claimed_at") @db.Timestamptz(3)
  confirmationEmailSentAt    DateTime?       @map("confirmation_email_sent_at") @db.Timestamptz(3)
  confirmationEmailAttempts  Int             @default(0) @map("confirmation_email_attempts")
  createdAt                  DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                  DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  student     User         @relation("OrderStudent", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  course      Course       @relation(fields: [courseId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  payments    Payment[]
  enrollments Enrollment[]

  @@index([userId, createdAt])
  @@index([courseId])
  @@index([status, mode, createdAt])
  @@index([status, lastReconciledAt])
  @@map("orders")
}

/// One provider payment (attempt) for an order. Rows are never reused for a different provider
/// payment; `providerPaymentId` is unique.
model Payment {
  id                  String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId             String          @map("order_id") @db.Uuid
  userId              String          @map("user_id") @db.Uuid
  provider            PaymentProvider @default(RAZORPAY)
  mode                PaymentMode
  providerPaymentId   String          @map("provider_payment_id") @db.VarChar(64)
  providerOrderId     String          @map("provider_order_id") @db.VarChar(64)
  status              PaymentStatus
  amountMinor         Int             @map("amount_minor")
  currency            String          @db.Char(3)
  /// card / upi / netbanking / wallet … (no card numbers or other instrument data are stored).
  method              String?         @db.VarChar(30)
  errorCode           String?         @map("error_code") @db.VarChar(100)
  errorDescription    String?         @map("error_description") @db.VarChar(500)
  /// Sum of PROCESSED refunds (or the provider's amount_refunded, whichever is larger).
  refundedMinor       Int             @default(0) @map("refunded_minor")
  /// Set when the Checkout signature was verified for this payment.
  signatureVerifiedAt DateTime?       @map("signature_verified_at") @db.Timestamptz(3)
  authorizedAt        DateTime?       @map("authorized_at") @db.Timestamptz(3)
  capturedAt          DateTime?       @map("captured_at") @db.Timestamptz(3)
  failedAt            DateTime?       @map("failed_at") @db.Timestamptz(3)
  /// Set when THIS payment moved its order to PAID (and activated the enrolment).
  appliedAt           DateTime?       @map("applied_at") @db.Timestamptz(3)
  /// Why a captured payment needs an administrator (amount mismatch, order already paid …).
  reviewReason        String?         @map("review_reason") @db.VarChar(300)
  createdAt           DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  student User     @relation("PaymentStudent", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  refunds Refund[]

  @@unique([provider, providerPaymentId])
  @@index([orderId])
  @@index([userId, createdAt])
  @@index([status, mode, capturedAt])
  @@map("payments")
}

/// A refund of (part of) a captured payment. Requested by an administrator through the API, or
/// discovered from a provider webhook when issued in the Razorpay Dashboard (`requestedById` null).
model Refund {
  id               String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  paymentId        String          @map("payment_id") @db.Uuid
  provider         PaymentProvider @default(RAZORPAY)
  mode             PaymentMode
  /// Our idempotency key at the provider (Razorpay refuses a duplicate receipt per payment).
  receipt          String?         @unique @db.VarChar(40)
  /// Client-supplied key that makes a repeated admin request return the same refund.
  idempotencyKey   String?         @unique @map("idempotency_key") @db.VarChar(64)
  providerRefundId String?         @unique @map("provider_refund_id") @db.VarChar(64)
  amountMinor      Int             @map("amount_minor")
  currency         String          @db.Char(3)
  status           RefundStatus
  reason           String?         @db.VarChar(500)
  failureReason    String?         @map("failure_reason") @db.VarChar(500)
  requestedById    String?         @map("requested_by_id") @db.Uuid
  /// The administrator chose to cancel the course enrolment together with this refund.
  revokedAccess    Boolean         @default(false) @map("revoked_access")
  processedAt      DateTime?       @map("processed_at") @db.Timestamptz(3)
  notifiedAt       DateTime?       @map("notified_at") @db.Timestamptz(3)
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  payment     Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  requestedBy User?   @relation("RefundRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([paymentId])
  @@index([status, mode, createdAt])
  @@index([requestedById])
  @@map("refunds")
}

/// One received provider webhook, deduplicated by the provider's event id (x-razorpay-event-id).
/// Only a minimal, sanitized extract of the payload is stored (no email/phone/instrument data).
model PaymentWebhookEvent {
  id          String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider    PaymentProvider    @default(RAZORPAY)
  mode        PaymentMode
  eventId     String             @map("event_id") @db.VarChar(100)
  eventType   String             @map("event_type") @db.VarChar(60)
  status      WebhookEventStatus @default(RECEIVED)
  attempts    Int                @default(0)
  /// SHA-256 of the raw body (hex).
  payloadHash String             @map("payload_hash") @db.Char(64)
  data        Json
  /// Why it was ignored, or the error class of the last failure (never secrets or bodies).
  note        String?            @db.VarChar(500)
  receivedAt  DateTime           @default(now()) @map("received_at") @db.Timestamptz(3)
  processedAt DateTime?          @map("processed_at") @db.Timestamptz(3)
  updatedAt   DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([provider, mode, eventId])
  @@index([status, receivedAt])
  @@map("payment_webhook_events")
}

/// Append-only audit trail of financial events and administrator actions (refunds, reconciliation,
/// rejected verifications, enrolment activation). No FK on the subject so history survives.
model PaymentAuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// e.g. "order.paid", "payment.verification_failed", "refund.requested".
  action     String   @db.VarChar(60)
  /// null for the system (webhooks, reconciliation worker).
  actorId    String?  @map("actor_id") @db.Uuid
  entityType String   @map("entity_type") @db.VarChar(40)
  entityId   String   @map("entity_id") @db.Uuid
  data       Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  actor User? @relation("PaymentAuditActor", fields: [actorId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([entityType, entityId, createdAt])
  @@index([actorId])
  @@map("payment_audit_logs")
}
