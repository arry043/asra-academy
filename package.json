{
  "name": "asra-academy",
  "version": "0.1.0",
  "private": true,
  "description": "ASRA Academy — Online Learning Platform & LMS (Marvel's Techworks)",
  "license": "UNLICENSED",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10"
  },
  "scripts": {
    "build:packages": "npm run build -w @asra/types -w @asra/validation",
    "predev": "npm run build:packages",
    "dev": "concurrently -k -n api,web -c blue,green \"npm run dev -w @asra/api\" \"npm run dev -w @asra/web\"",
    "dev:api": "npm run build:packages && npm run dev -w @asra/api",
    "dev:web": "npm run build:packages && npm run dev -w @asra/web",
    "build": "npm run build:packages && npm run build -w @asra/api -w @asra/web",
    "start:api": "npm run start -w @asra/api",
    "start:web": "npm run start -w @asra/web",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run build:packages && npm run typecheck --workspaces --if-present",
    "clean": "npm run clean --workspaces --if-present",
    "db:generate": "npm run db:generate -w @asra/api",
    "db:validate": "npm run db:validate -w @asra/api",
    "db:migrate": "npm run db:migrate -w @asra/api",
    "db:migrate:deploy": "npm run db:migrate:deploy -w @asra/api",
    "db:studio": "npm run db:studio -w @asra/api",
    "db:seed": "npm run db:seed -w @asra/api",
    "check:services": "npm run check:services -w @asra/api",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:ps": "docker compose ps",
    "docker:logs": "docker compose logs -f",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.10.0",
    "concurrently": "^10.0.6",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.7.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1"
  },
  "allowScripts": {
    "prisma@7.10.0": true,
    "@prisma/engines@7.10.0": true,
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true
  }
}
